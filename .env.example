# Environment configuration for BreathQuest
# Copy this file to .env for local development

# Deployment environment: development | testing | production
FLASK_ENV=development

# Secret key for sessions and CSRF protection
# Generate a new random secret with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-secret-key-change-in-production-min-32-chars

# Database URL
# Uses SQLite in the Flask instance directory by default:
DATABASE_URL=sqlite:///breathquest.db

# Cookie policy
# Set to true when serving behind HTTPS
SESSION_COOKIE_SECURE=false

# Optional server configuration
PORT=8080
HOST=127.0.0.1

# Microsoft 365 / Entra ID SSO Configuration
# Domain enforced for student, faculty, and admin logins
M365_TENANT_DOMAIN=nursingmu.org

# Azure AD App Registration (Set when deploying institutional SSO)
# M365_CLIENT_ID=your-azure-app-client-id
# M365_CLIENT_SECRET=your-azure-app-client-secret
# M365_TENANT_ID=your-azure-tenant-id-or-common
# M365_REDIRECT_URI=https://your-domain.nursingmu.org/auth/microsoft/callback
